{
  "datasets": [
    {
      "name": "9c1973ac",
      "displayName": "ds_kpis",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM crm_poc.gold.customer_overview) AS total_customers,\n",
        "  (SELECT SUM(pipeline_inr) FROM crm_poc.gold.opportunity_pipeline) AS open_pipeline_inr,\n",
        "  (SELECT SUM(won_revenue_inr) FROM crm_poc.gold.sales_trends) AS won_revenue_inr,\n",
        "  (SELECT ROUND(100.0 * SUM(converted_leads) / SUM(total_leads), 1) FROM crm_poc.gold.lead_conversion) AS lead_conversion_pct,\n",
        "  (SELECT dq_score_pct FROM crm_poc.gold.data_quality_score) AS dq_score_pct"
      ]
    },
    {
      "name": "9b25dc80",
      "displayName": "ds_pipeline_by_stage",
      "queryLines": [
        "SELECT stage, stage_order, industry, lead_source, close_month,\n",
        "       SUM(deal_count) AS deals,\n",
        "       SUM(pipeline_inr) AS pipeline_inr,\n",
        "       SUM(weighted_pipeline_inr) AS weighted_pipeline_inr\n",
        "FROM crm_poc.gold.opportunity_pipeline\n",
        "GROUP BY stage, stage_order, industry, lead_source, close_month"
      ]
    },
    {
      "name": "8dda475a",
      "displayName": "ds_sales_trends",
      "queryLines": [
        "SELECT month, won_revenue_inr, won_deals, lost_deals, avg_won_deal_inr, win_rate_pct\n",
        "FROM crm_poc.gold.sales_trends\n",
        "ORDER BY month"
      ]
    },
    {
      "name": "20d48a76",
      "displayName": "ds_lead_conversion",
      "queryLines": [
        "SELECT lead_source, total_leads, converted_leads, open_leads, conversion_pct\n",
        "FROM crm_poc.gold.lead_conversion\n",
        "ORDER BY conversion_pct DESC"
      ]
    },
    {
      "name": "18562bdc",
      "displayName": "ds_top_customers",
      "queryLines": [
        "SELECT account_name, industry, city, contact_count, won_deals,\n",
        "       won_revenue_inr, open_pipeline_inr\n",
        "FROM crm_poc.gold.customer_overview\n",
        "ORDER BY won_revenue_inr DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "863984ce",
      "displayName": "ds_hot_leads",
      "queryLines": [
        "SELECT lead_grade, lead_score, lead_name, company, title, lead_source, rating, city, email\n",
        "FROM crm_poc.gold.lead_scores\n",
        "WHERE lead_grade = 'Hot'\n",
        "ORDER BY lead_score DESC"
      ]
    },
    {
      "name": "5b6fe589",
      "displayName": "ds_at_risk_deals",
      "queryLines": [
        "SELECT risk_level, opportunity_name, account_name, stage, amount_inr,\n",
        "       close_date, days_to_close, risk_reason\n",
        "FROM crm_poc.gold.at_risk_deals\n",
        "ORDER BY risk_level, amount_inr DESC"
      ]
    },
    {
      "name": "65ac1a69",
      "displayName": "ds_data_quality",
      "queryLines": [
        "SELECT object_name, total_rows, failed_rows, pass_pct, checked_at\n",
        "FROM crm_poc.gold.data_quality_checks\n",
        "ORDER BY object_name"
      ]
    }
  ],
